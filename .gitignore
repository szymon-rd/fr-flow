target/
project/target/
project/project/
.bsp/
.bloop/
.metals/
.idea/
.vscode/
.lake/

# FrFlow: derived from the Scala definitions and the prover, or local to a run. Committed: the
# ledger, the developer keys (.frflow/keys), the requests (.frflow/requests.json) and rocq/Proofs.
**/.frflow/kb.json
**/.frflow/checks.json
**/.frflow/tests.json
**/.frflow/consistency.json
**/.frflow/running.json
**/.frflow/*.lock
**/.frflow/*.tmp
examples/*/lean/FrFlowGen/
# What a check writes of a project's Rocq: the generated modules, where an editor finds what is compiled, and the
# build. A project keeps rocq/Proofs.
examples/*/rocq/FrFlowGen/
examples/*/rocq/_CoqProject
examples/*/rocq/_build/
examples/*/lean/FrFlowAudit/


# Rocq's outputs beside FrFlow's Rocq library.
*.vo
*.vok
*.vos
*.glob
.*.aux

__pycache__/

# Rocq's cache for `lia`, written where a proof is compiled.
.lia.cache
# Worktrees of agents working beside this checkout.
.claude/worktrees/
