@[frflow_defs] def login.check (s : State) (p : Login) : Prop := (p.user ≠ UserId.Anonymous) ∧ (¬(s.sessions p.token ≠ none))
@[frflow_defs] def login.guard (s : State) (p : Login) : Prop := login.assume s p ∧ login.check s p
