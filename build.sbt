ThisBuild / scalaVersion := "3.10.0"
ThisBuild / scalacOptions ++= Seq("-deprecation", "-feature", "-Werror")

val munit = "org.scalameta" %% "munit" % "1.1.1" % Test

lazy val root = project.in(file("."))
  .aggregate(model, protocol, lean, ledger, check, cli, auth, crm, keycloak)
  .settings(publish / skip := true)

def module(name: String) = Project(name, file(s"modules/$name"))
  .settings(Keys.name := s"frflow-$name", libraryDependencies += munit)

/** The DSL: nodes, the knowledge base, the macro from Scala to Lean, the runtime checks (package `frflow`). */
lazy val model = module("model")

/** The data crossing modules and files: the snapshot, the review, the ledger, checks and requests,
  * with their JSON codecs; ids and statuses as types (package `frflow.protocol`).
  */
lazy val protocol = module("protocol").settings(libraryDependencies ++= Seq(
  "io.circe" %% "circe-core" % "0.14.17", "io.circe" %% "circe-parser" % "0.14.17"))

/** The Lean of a knowledge base, and reading Lean's output. */
lazy val lean = module("lean").dependsOn(model % "compile->compile;test->test", protocol)

/** The developer's decisions: review states, the ledger, signatures. */
lazy val ledger = module("ledger").dependsOn(protocol)

/** Rendering and checking a knowledge base against Lean; the snapshot. */
lazy val check = module("check").dependsOn(lean % "compile->compile;test->test", ledger, model % "test->test")

/** The command line a project's main object extends (`FrFlowApp`). */
lazy val cli = module("cli").dependsOn(check)

def example(name: String) = Project(name, file(s"examples/$name"))
  .dependsOn(cli, check % Test)
  .settings(
    libraryDependencies += munit,
    publish / skip := true,
    run / fork := true,
    // The CLI's output (read by agents) is UTF-8 whatever the locale.
    run / javaOptions ++= Seq("-Dstdout.encoding=UTF-8", "-Dstderr.encoding=UTF-8", "-Dfile.encoding=UTF-8"),
    // Every source the build compiles, so code in a source directory added here is governed too.
    run / javaOptions += "-Dfrflow.sources=" + (Compile / sources).value.map(_.getAbsolutePath).mkString(java.io.File.pathSeparator),
    run / baseDirectory := (ThisBuild / baseDirectory).value,
    Test / fork := true,
    Test / baseDirectory := (ThisBuild / baseDirectory).value
  )

/** Access control: who can access what, refined through grants, sessions and requests to proven code. */
lazy val auth = example("auth")

/** A multi-tenant CRM: one purpose (users find exactly their company's and shared records, write only
  * their company's), refined through the domain to proven code, served over HTTP from SQLite.
  */
lazy val crm = example("crm").settings(libraryDependencies += "org.xerial" % "sqlite-jdbc" % "3.46.1.3",
  Compile / run / mainClass := Some("crm.crmCli"))

/** A synthetic project, generated by `bench/generate.py N`, to measure FrFlow as it grows (not built by default). */
lazy val scale = example("scale")

/** A Keycloak-like authentication server: realms, sign-in, token introspection, sign-out. */
lazy val keycloak = example("keycloak").settings(Compile / run / mainClass := Some("keycloak.keycloakCli"))
