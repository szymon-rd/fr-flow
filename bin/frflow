#!/bin/sh
# Runs the FrFlow tools from this repository:
#   bin/frflow serve [--port 8765] examples     the browser, where the developer decides
#   bin/frflow mcp examples                     the MCP server, for agents
# The classpath is computed once with sbt and cached; it is recomputed when the sources change.
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
cache="$here/tools/target/frflow.classpath"
if [ ! -s "$cache" ] || [ -n "$(find "$here/tools/src" "$here/core/src/main" "$here/build.sbt" -newer "$cache" 2>/dev/null | head -n 1)" ]; then
  mkdir -p "$here/tools/target"
  (cd "$here" && sbt -error "tools/compile" "export tools/Runtime/fullClasspath" < /dev/null 2>/dev/null) | grep -v '^Picked up' | tail -n 1 > "$cache.tmp"
  mv "$cache.tmp" "$cache"
fi
exec java -cp "$(cat "$cache")" frflow.tools.Main "$@"
