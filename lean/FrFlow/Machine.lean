import FrFlow.Refinement

/-!
# FrFlow kernel: event machines

Theory nodes are rendered as event machines in the style of Event-B: a state
type, an initial predicate and a list of guarded events. Each event has its
own parameter type, so nondeterministic choice ("any p where guard") is
expressed through parameters.

Per-event proof obligations (generated by the Scala side) are assembled into
a `Refinement` by `Machine.refinement`, and into machine invariants by
`Machine.invariant`. Those two definitions are the only bridge between
generated obligations and kernel theorems.
-/

namespace FrFlow

structure Event (σ : Type) where
  Param : Type
  guard : σ → Param → Prop
  act   : σ → Param → σ

structure Machine where
  State  : Type
  Init   : State → Prop
  events : List (Event State)

def Machine.Next (M : Machine) (s s' : M.State) : Prop :=
  ∃ e ∈ M.events, ∃ p, e.guard s p ∧ s' = e.act s p

def Machine.toSpec (M : Machine) : Spec :=
  { State := M.State, Init := M.Init, Next := M.Next }

/-- A predicate holds for every event of a list. Unfolds to a conjunction,
so generated code can supply it as an anonymous-constructor tuple. -/
def AllEvents {σ : Type} (P : Event σ → Prop) : List (Event σ) → Prop
  | [] => True
  | e :: es => P e ∧ AllEvents P es

theorem AllEvents.mem {σ : Type} {P : Event σ → Prop} :
    ∀ {l : List (Event σ)}, AllEvents P l → ∀ e, e ∈ l → P e
  | [], _, _, he => by cases he
  | _ :: _, ⟨h, hs⟩, e, he => by
    cases he with
    | head => exact h
    | tail _ he' => exact AllEvents.mem hs e he'

/-- Event `e` preserves predicate `inv`. -/
def EventPreserves {σ : Type} (inv : σ → Prop) (e : Event σ) : Prop :=
  ∀ s p, inv s → e.guard s p → inv (e.act s p)

/-- Event `e` of a concrete machine is simulated by the abstract machine `A`
under abstraction `abs` and gluing invariant `inv`. -/
def EventSim (A : Machine) {σ : Type} (abs : σ → A.State) (inv : σ → Prop)
    (e : Event σ) : Prop :=
  ∀ s p, inv s → e.guard s p →
    inv (e.act s p) ∧ (A.Next (abs s) (abs (e.act s p)) ∨ abs s = abs (e.act s p))

/-- A concrete event refining abstract event `ae` with witness `w`:
guard strengthening (`hgrd`) and action simulation (`hsim`). -/
theorem EventSim.refines {A : Machine} {σ : Type} {abs : σ → A.State}
    {inv : σ → Prop} {e : Event σ}
    (ae : Event A.State) (hmem : ae ∈ A.events) (w : σ → e.Param → ae.Param)
    (hinv : EventPreserves inv e)
    (hgrd : ∀ s p, inv s → e.guard s p → ae.guard (abs s) (w s p))
    (hsim : ∀ s p, inv s → e.guard s p → abs (e.act s p) = ae.act (abs s) (w s p)) :
    EventSim A abs inv e := by
  intro s p hi hg
  exact ⟨hinv s p hi hg, Or.inl ⟨ae, hmem, w s p, hgrd s p hi hg, hsim s p hi hg⟩⟩

/-- A new concrete event that refines `skip`: it does not change the
abstract state. -/
theorem EventSim.skip {A : Machine} {σ : Type} {abs : σ → A.State}
    {inv : σ → Prop} {e : Event σ}
    (hinv : EventPreserves inv e)
    (hskip : ∀ s p, inv s → e.guard s p → abs (e.act s p) = abs s) :
    EventSim A abs inv e := by
  intro s p hi hg
  exact ⟨hinv s p hi hg, Or.inr (hskip s p hi hg).symm⟩

/-- Assemble per-event obligations into a refinement. -/
def Machine.refinement (C A : Machine) (abs : C.State → A.State) (inv : C.State → Prop)
    (hinit : ∀ s, C.Init s → inv s ∧ A.Init (abs s))
    (hev : AllEvents (EventSim A abs inv) C.events) :
    Refinement C.toSpec A.toSpec where
  abs := abs
  inv := inv
  init_ok := hinit
  step_ok := by
    intro s s' hi hn
    obtain ⟨e, he, p, hg, hs⟩ := hn
    subst hs
    exact AllEvents.mem hev e he s p hi hg

/-- Assemble per-event preservation obligations into a machine invariant. -/
theorem Machine.invariant (M : Machine) (inv : M.State → Prop)
    (hinit : ∀ s, M.Init s → inv s)
    (hev : AllEvents (EventPreserves inv) M.events) :
    Invariant M.toSpec inv := by
  refine Invariant.of_inductive (S := M.toSpec) hinit ?_
  intro s s' hi hn
  obtain ⟨e, he, p, hg, hs⟩ := hn
  subst hs
  exact AllEvents.mem hev e he s p hi hg

end FrFlow
